{
  "name": "moonpool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An open-source runtime for embedding sandboxed web mini apps inside native applications.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.browser.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "build": "pnpm --filter \"./examples/*\" build",
    "dev": "pnpm --parallel --filter \"./examples/*\" dev"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
