{
  "name": "moonpool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An open-source runtime for embedding sandboxed web mini apps inside native applications.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "build": "echo \"build: not wired yet (v0 skeleton)\"",
    "dev": "pnpm -C examples/mock-host dev"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4"
  }
}
